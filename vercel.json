{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/workouts",
      "destination": "/workouts.html"
    },
    {
      "source": "/workout-session",
      "destination": "/workout-session.html"
    },
    {
      "source": "/programs",
      "destination": "/programs.html"
    },
    {
      "source": "/program-detail",
      "destination": "/program-detail.html"
    },
    {
      "source": "/progress",
      "destination": "/progress.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/subscription",
      "destination": "/subscription.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/termsofservice",
      "destination": "/termsofservice.html"
    },
    {
      "source": "/cookiepolicy",
      "destination": "/cookiepolicy.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/policy",
      "destination": "/policy.html"
    },
    {
      "source": "/privacy",
      "destination": "/policy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/renew",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/internal/cron/reconcile",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/retry",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire",
      "schedule": "0 2 * * *"
    }
  ],
  "cleanUrls": true
}