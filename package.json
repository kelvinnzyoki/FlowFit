{
  "name": "flowfit-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready Node.js backend for FlowFit SaaS platform",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "npx prisma generate --schema=./prisma/schema.prisma && npx tsc",
    "vercel-build": "npx prisma generate --schema=./prisma/schema.prisma && (npx prisma migrate resolve --rolled-back 20260349000000_add_missing_table5 --schema=./prisma/schema.prisma 2>/dev/null || true) && npx prisma migrate deploy --schema=./prisma/schema.prisma && npx tsc",
    "postinstall": "npx prisma generate --schema=./prisma/schema.prisma",
    "start": "node dist/src/server.js",
    "typecheck": "npx tsc --noEmit",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "fitness",
    "saas",
    "workout",
    "tracking",
    "nodejs",
    "express",
    "postgresql",
    "redis"
  ],
  "author": "FlowFit Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.52.7",
    "prisma": "^5.9.1",
    "rate-limit-redis": "^4.2.0",
    "resend": "^3.5.0",
    "stripe": "^17.7.0",
    "typescript": "^5.4.0",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=9.0.0"
  }
}
